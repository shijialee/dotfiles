source ~/.orbstack/shell/init.bash 2>/dev/null || :

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
if [ -x "$PYENV_ROOT/bin/pyenv" ]; then
    export PATH="$PYENV_ROOT/bin:$PATH"
fi
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"


# ~/.zshrc or ~/.bashrc
safe() { 
    safehouse \
        --add-dirs-ro="/etc/profile" \
        --add-dirs-ro="$HOME/.gitignore_global" \
        --add-dirs-ro="$HOME/.bash_profile" \
        --add-dirs-ro="$HOME/.dotfiles/link/.bash_profile" \
        "$@";
}

# Sandboxed — the default. Just type the command name.
claude()   { safe claude --dangerously-skip-permissions "$@"; }
codex()    { safe codex --dangerously-bypass-approvals-and-sandbox "$@"; }
amp()      { safe amp --dangerously-allow-all "$@"; }
gemini()   { NO_BROWSER=true safe gemini --yolo "$@"; }

